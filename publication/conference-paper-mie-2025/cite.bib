@inproceedings{Lunardi2025Agent,
	title        = {{Agent-Based Healthcare Chatbots for Regional System Services: A Case Study in the Friuli-Venezia Giulia Region}},
	author       = {Riccardo Lunardi and Kevin Roitero and Michael Soprano and Paolo Coppola and Vincenzo Della Mea and Stefano Mizzaro},
	year         = 2025,
	booktitle    = {{Intelligent Health Systems – From Technology to Data and Knowledge}},
	publisher    = {IOS Press},
	address      = {Amsterdam, Netherlands},
	series       = {Studies in Health Technology and Informatics},
	volume       = 327,
	pages        = {677--681},
	doi          = {10.3233/SHTI250434},
	isbn         = {978-1-64368-485-7},
	editor       = {Elisavet Andrikopoulou and Parisis Gallos and Theodoros N. Arvanitis and Robin Austin and Arriel Benis and Ronald Cornet and Panagiotis Chatzistergos and Andreas Dejaco and Liselotte Dusseljee-Peute and Ahmed Mohasseb and Panagiotis Natsiavas and Hussein Nakkas and Philip Scott},
	abstract     = {This paper presents a case study on the development and implementation of agent-based healthcare chatbots within the regional healthcare system of Friuli-Venezia Giulia, Italy. The study focuses on integrating conversational agents into public health services to enhance citizen access to electronic health records (EHRs) and facilitate interactions with healthcare providers. The chatbot model aims to improve user experience by providing natural language interfaces for tasks such as searching for available doctors and pediatricians. The paper discusses the design considerations, implementation challenges, and potential benefits of deploying such conversational agents in public administration portals.},
	keywords     = {agent-based model, chatbots, regional system services}
}
