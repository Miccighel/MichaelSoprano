@inproceedings{Lunardi2025Agent,
	title        = {{Agent-Based Healthcare Chatbots for Regional System Services: A Case Study in the Friuli-Venezia Giulia Region}},
	author       = {Lunardi, Riccardo and Roitero, Kevin and Soprano, Michael and Coppola, Paolo and {Della Mea}, Vincenzo and Mizzaro, Stefano},
	year         = 2025,
	month        = 5,
	day          = 16,
	booktitle    = {{Intelligent Health Systems – From Technology to Data and Knowledge}},
	location     = {Glasgow, Scotland},
	publisher    = {IOS Press},
	address      = {Amsterdam, Netherlands},
	series       = {Studies in Health Technology and Informatics},
	volume       = 327,
	pages        = {677--681},
	doi          = {10.3233/SHTI250434},
	isbn         = {978-1-64368-596-0},
	editor       = {Elisavet Andrikopoulou and Parisis Gallos and Theodoros N. Arvanitis and Rosalynn Austin and Arriel Benis and Ronald Cornet and Panagiotis Chatzistergos and Alexander Dejaco and Linda Dusseljee-Peute and Alaa Mohasseb and Pantelis Natsiavas and Haythem Nakkas and Philip Scott},
	abstract     = {This paper presents an agent-based model for interacting with regional healthcare system services in the Friuli-Venezia Giulia (FVG) region. The model is designed to streamline and automate tasks traditionally managed through human intervention. We showcase its implementation on three key applications: booking medical appointments, identifying available emergency rooms, and performing question-and-answer (Q\&A) interactions on medication leaflets. The system leverages autonomous agents to provide real-time responses, aiming to improve the overall performance of healthcare services.},
	keywords     = {Agent-Based Model, Chatbots, Regional System Services}
