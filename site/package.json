{
  "name": "michael-soprano-site",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.14.0"
  },
  "scripts": {
    "vendor": "ruby scripts/vendor-assets.rb",
    "check:content": "ruby scripts/check-content.rb",
    "build": "ruby scripts/build-site.rb",
    "check": "ruby scripts/build-site.rb --audit",
    "check:links": "ruby scripts/check-external-links.rb"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@fortawesome/fontawesome-free",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "@fontsource/lato": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "academicons": "1.9.5",
    "leaflet": "1.9.4",
    "pagefind": "1.5.2"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "4.3.3"
  }
}
