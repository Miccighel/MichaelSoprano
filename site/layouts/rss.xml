{{- $context := cond .IsHome site . -}}
{{- $pages := where $context.RegularPages "Params.private" "!=" true -}}
{{- with site.Config.Services.RSS.Limit -}}
  {{- if ge . 1 }}{{ $pages = first . $pages }}{{ end -}}
{{- end -}}
{{- $siteTitle := site.Params.identity.name | default site.Title -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if and .Title (ne .Title site.Title) }}{{ .Title }} | {{ end }}{{ $siteTitle }}</title>
    <link>{{ .Permalink }}</link>
    {{- with .OutputFormats.Get "RSS" }}
      {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    <description>{{ .Description | default site.Params.identity.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    {{- with site.Language.Locale }}<language>{{ . }}</language>{{ end }}
    {{- if not .Date.IsZero }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
